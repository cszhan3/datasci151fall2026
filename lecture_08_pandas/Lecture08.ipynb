      "Peter's birthday is June 20\n"
     ]
    }
   ],
   "source": [
    "def print_birthday(name, month, *, day):\n",
    "    return name + \"'s birthday is \" +  month + ' ' + str(day)\n",
    "\n",
    "# print(print_birthday(name = \"Peter\", month = \"June\", day = 20))\n",
    "print(print_birthday(\"Peter\",\"June\", day = 20))"
   ]
  },
